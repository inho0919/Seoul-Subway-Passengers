# API 인증키
SEOUL_OPEN_API_KEY=[서울열린데이터광장_인증키]
DATA_GO_KR_SERVICE_KEY=[공공데이터포털_인증키]

# 서울열린데이터광장, 노선별 지하철역 정보 API 설정
API_BASE_URL=[서울열린데이터광장_API_기본주소]
API_SERVICE=[노선별_지하철역_정보_서비스명]
PASSENGER_API_URL=[역별승하차인원_API_요청주소]

# PostgreSQL 접속 정보
POSTGRES_HOST=[HOSTNAME]
POSTGRES_PORT=[PORT]
POSTGRES_DB=[DATABASE]
POSTGRES_USER=[USERNAME]
POSTGRES_PASSWORD=[PASSWORD]

# ETL 실행 설정
ETL_LOOKBACK_DAYS=[재수집_대상_일수]
ETL_PAGE_SIZE=[API_1회_요청건수]
ETL_TIMEZONE=[실행기준_시간대]
LOG_LEVEL=[로그_출력_수준]